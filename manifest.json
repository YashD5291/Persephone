{
  "manifest_version": 3,
  "name": "Persephone",
  "version": "1.0.0",
  "description": "Automatically sends Grok and Claude responses to Telegram",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://api.telegram.org/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://x.com/i/grok*",
        "https://claude.ai/*"
      ],
      "exclude_matches": [
        "https://claude.ai/oauth/*",
        "https://claude.ai/login*",
        "https://claude.ai/logout*"
      ],
      "js": [
        "content/constants.js",
        "content/logger.js",
        "content/state.js",
        "content/selectors.js",
        "content/text.js",
        "content/telegram.js",
        "content/buttons.js",
        "content/pacer.js",
        "content/streaming.js",
        "content/voice.js",
        "content/screenshot.js",
        "content/widget.js",
        "content/styles.js",
        "content/init.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "send-live-question": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "global": true,
      "description": "Send the question waiting in the target chat"
    },
    "toggle-live-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+2"
      },
      "global": true,
      "description": "Live text on/off (text goes to the target chat)"
    }
  }
}
